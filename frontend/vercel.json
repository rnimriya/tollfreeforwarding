{
  "version": 2,
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "$BACKEND_URL/api/:path*"
    },
    {
      "source": "/webhook/:path*",
      "destination": "$BACKEND_URL/webhook/:path*"
    },
    {
      "source": "/health",
      "destination": "$BACKEND_URL/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
